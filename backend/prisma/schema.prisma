// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String
  password  String?
  kycData   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentPlans PaymentPlan[]
  propertyInterests PropertyInterest[]
}

model Property {
  id                 String   @id @default(uuid())
  address            String
  description        String?
  images             String[]
  planTypesAvailable PlanType[]
  requiredFormFields Json?    // Configured by admin for clients to fill
  basePrice          Decimal
  currency           String   @default("GHS")
  status             PropertyStatus @default(AVAILABLE)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  paymentPlans       PaymentPlan[]
  interests          PropertyInterest[]
  projectUpdates     ProjectUpdate[]
}

enum PropertyStatus {
  AVAILABLE
  SOLD
  RENTED
}

enum PlanType {
  RENT_TO_OWN
  PAY_TO_OWN
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
}

model PaymentPlan {
  id             String     @id @default(uuid())
  clientId       String
  propertyId     String
  type           PlanType
  totalAmount    Decimal
  equityAccrued  Decimal    @default(0)
  currency       String     @default("GHS")
  scheduleDetails Json
  status         PlanStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  client         Client     @relation(fields: [clientId], references: [id])
  property       Property   @relation(fields: [propertyId], references: [id])
  ledgerEntries  LedgerEntry[]
  invoices       Invoice[]
}

enum EntryType {
  PAYMENT
  FEE
  PENALTY
  EQUITY_ACCRUAL
  RENT_DEDUCTION
}

model LedgerEntry {
  id             String      @id @default(uuid())
  paymentPlanId  String
  type           EntryType
  amountGHS      Decimal
  paymentId      String?
  transactionDate DateTime   @default(now())
  createdAt      DateTime    @default(now())

  paymentPlan    PaymentPlan @relation(fields: [paymentPlanId], references: [id])
  payment        Payment?    @relation(fields: [paymentId], references: [id])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id                    String        @id @default(uuid())
  provider              String        @default("PAYSTACK")
  providerTransactionId String        @unique
  status                PaymentStatus @default(PENDING)
  originalCurrency      String
  originalAmount        Decimal
  settledCurrency       String        @default("GHS")
  settledAmount         Decimal?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  ledgerEntries         LedgerEntry[]
}

model Invoice {
  id             String      @id @default(uuid())
  paymentPlanId  String
  amountDue      Decimal
  dueDate        DateTime
  isPaid         Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  paymentPlan    PaymentPlan @relation(fields: [paymentPlanId], references: [id])
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN") // e.g., ADMIN, SUPERADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InterestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model PropertyInterest {
  id             String         @id @default(uuid())
  clientId       String
  propertyId     String
  submittedData  Json           // Form data submitted by client
  status         InterestStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  client         Client         @relation(fields: [clientId], references: [id])
  property       Property       @relation(fields: [propertyId], references: [id])
}

model ProjectUpdate {
  id             String      @id @default(uuid())
  propertyId     String
  title          String
  content        String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  property       Property    @relation(fields: [propertyId], references: [id])
}
