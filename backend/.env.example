# Cereno Homes Backend - Environment Variables Configuration

# Server Config
PORT=3000

# Authentication (Required for Production)
JWT_SECRET=generate_a_strong_random_string_here_for_production

# Database (Prisma)
# DO App Platform will inject this automatically if you attach a managed database
DATABASE_URL="postgresql://user:password@localhost:5432/cereno_db"

# Stripe Integration (Live/Test)
STRIPE_SECRET_KEY=sk_live_or_test_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_webhook_secret_here

# Legacy Paystack Integration (optional fallback)
PAYSTACK_SECRET_KEY=sk_test_or_live_secret_key_here

# Frontend URL (For CORS and email links)
FRONTEND_URL=https://cerenohomes.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin Credentials (used by seed script)
ADMIN_EMAIL=info@cerenohomesghana.com
ADMIN_PASSWORD=your_secure_password_here

# Email / SMTP Configuration
# If info@cerenohomesghana.com is hosted on Google Workspace / Gmail:
# 1. Enable 2-Step Verification on Google (myaccount.google.com/security)
# 2. Generate an App Password (myaccount.google.com/apppasswords)
SMTP_SERVICE=gmail
SMTP_USER=info@cerenohomesghana.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="Cereno Homes" <info@cerenohomesghana.com>

# Alternatively, if hosted on standard webmail/cPanel SMTP:
# SMTP_HOST=mail.cerenohomesghana.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@cerenohomesghana.com
# SMTP_PASS=your_email_password
# SMTP_FROM="Cereno Homes" <info@cerenohomesghana.com>

